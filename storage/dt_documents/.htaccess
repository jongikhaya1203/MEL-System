# Deny all direct access — Digital Transformation deliverable documents and
# sign-off signatures are only served through digital/download.php and
# digital/signature.php, which check the requester is logged in.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
