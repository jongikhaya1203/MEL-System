# Deny all direct access — acceptance form signatures and proof images must
# only be served through sites/acceptance_file.php, which checks the requester is
# logged in.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
